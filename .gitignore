# =============================================================================
# .gitignore — OT-Asset-Registry
# IMPORTANTE: Git solo reconoce comentarios que INICIAN la línea con '#'.
# Un '#' después de un patrón NO es comentario: se vuelve parte del patrón
# y la regla deja de funcionar. Por eso cada comentario va en su propia línea.
# =============================================================================

# --- Secretos y configuración local ---
# Variables sensibles (SECRET_KEY, credenciales de BD). NUNCA al repo.
.env
.env.*
# Excepción: la plantilla SIN secretos sí se versiona (debe ir DESPUÉS de .env.*)
!.env.example

# --- Base de datos de desarrollo ---
# La BD local son datos, no código.
*.sqlite3
*.sqlite3-journal

# --- Entorno virtual de Python ---
# Se reconstruye desde requirements.txt.
venv/
.venv/
env/
ENV/

# --- Artefactos de Python ---
# Bytecode regenerable.
__pycache__/
*.py[cod]
*$py.class

# --- Django ---
# Archivos subidos por usuarios.
/media/
# Salida de collectstatic (se genera en despliegue).
/staticfiles/
/static_root/
# Logs locales.
*.log
local_settings.py

# NOTA: NO ignorar las carpetas migrations/ — las migraciones SON el diseño
# versionado del esquema de base de datos y deben ir al repositorio.

# --- Editores / Sistema operativo ---
# Configuración local del editor (preferencia personal).
.vscode/
.idea/
# macOS
.DS_Store
# Windows
Thumbs.db

# --- Cobertura y pruebas ---
.coverage
htmlcov/
.pytest_cache/