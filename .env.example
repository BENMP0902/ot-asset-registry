# Plantilla de variables de entorno — OT-Asset-Registry
# -----------------------------------------------------------------------------
# Copia este archivo a .env  (cp .env.example .env) y rellena los valores reales.
# El archivo .env NUNCA se versiona (está en .gitignore). Este .example SÍ, para
# que cualquiera sepa QUÉ variables necesita, sin exponer los secretos.
# -----------------------------------------------------------------------------

# Clave criptográfica de Django. Genera una propia; NO uses este placeholder.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=reemplazar-con-una-clave-unica-y-secreta

# Modo depuración. True solo en desarrollo; SIEMPRE False en producción
# (DEBUG=True filtra trazas y configuración a un atacante).
DEBUG=True

# Hosts permitidos (separados por coma). En desarrollo:
ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a base de datos.
# Desarrollo (SQLite): dejar DATABASE_URL vacío para usar el default SQLite.
# Producción (PostgreSQL):
# DATABASE_URL=postgres://usuario:password@localhost:5432/ot_asset_registry
DATABASE_URL=
